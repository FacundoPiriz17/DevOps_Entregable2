  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "playhub-prometheus"
      },
      "description": "Targets del backend visibles por Prometheus, desglosados por slot (blue/green). El slot activo recibe tráfico del Service estable.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "text": "DOWN"
                },
                "1": {
                  "color": "green",
                  "text": "UP"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "13.2.3",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "playhub-prometheus"
          },
          "editorMode": "code",
          "expr": "max by (slot) (up{job=\"playhub-backend\"})",
          "instant": false,
          "legendFormat": "slot {{slot}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Targets del backend por slot",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "playhub-prometheus"
      },
      "description": "Cantidad de Pods de backend por slot según kube-state-metrics.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "13.2.3",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "playhub-prometheus"
          },
          "editorMode": "code",
          "expr": "count by (slot) (kube_pod_status_phase{phase=\"Running\", namespace=~\"$namespace\", pod=~\"playhub-backend-.*\"} == 1)",
          "instant": false,
          "legendFormat": "slot {{slot}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Pods de backend por slot",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "playhub-prometheus"
      },
      "description": "Requests procesados en los últimos 2 minutos por slot. El slot activo del Service estable es el único que recibe tráfico del puerto 8080.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "text",
                  "text": "inactivo"
                }
              },
              "type": "value"
            }
          ],
          "noValue": "sin datos",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "13.2.3",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "playhub-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (slot) (increase(http_server_requests_seconds_count{job=\"playhub-backend\", uri!~\"/actuator.*\"}[2m]))",
          "instant": false,
          "legendFormat": "slot {{slot}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Slot activo (requests en los últimos 2 min)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "playhub-prometheus"
      },
      "description": "Requests HTTP por segundo del backend, separados por slot. Al cambiar el tráfico con switch-slot, la curva del slot activo sube y la del anterior baja.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "req/s",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 20,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "reqps"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*blue.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "blue",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*green.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "id": 4,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "playhub-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (slot) (rate(http_server_requests_seconds_count{job=\"playhub-backend\", uri!~\"/actuator.*\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "slot {{slot}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Requests HTTP por segundo y slot",
      "type": "timeseries"
    },
