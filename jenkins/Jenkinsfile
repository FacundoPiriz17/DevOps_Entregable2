pipeline {
    agent any
    options {
        skipDefaultCheckout()
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 45, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20', artifactNumToKeepStr: '10'))
    }
    triggers { pollSCM('H/2 * * * *') }
    parameters {
        booleanParam(name: 'DEPLOY', defaultValue: true, description: 'Desplegar main en Minikube local con monitoreo.')
    }
    environment { PUBLIC_URL = 'http://localhost:8080' }
    stages {
        stage('1. Clonacion del repositorio') {
            steps {
                script {
                    def checkoutInfo = checkout scm
                    env.GIT_SHORT = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                    env.SOURCE_BRANCH = (env.BRANCH_NAME ?: checkoutInfo.GIT_BRANCH ?: env.GIT_BRANCH ?: '').trim()
                    if (!env.SOURCE_BRANCH) {
                        env.SOURCE_BRANCH = sh(script: '''
                            set -eu
                            branch="$(git symbolic-ref --quiet --short HEAD || true)"
                            if [ -n "$branch" ]; then
                                printf '%s' "$branch"
                            else
                                main_commit="$(git rev-parse --verify refs/remotes/origin/main 2>/dev/null || true)"
                                if [ -n "$main_commit" ] && [ "$(git rev-parse HEAD)" = "$main_commit" ]; then
                                    printf '%s' main
                                fi
                            fi
                        ''', returnStdout: true).trim()
                    }
                    if (!env.SOURCE_BRANCH && params.DEPLOY != false) {
                        error('No se pudo identificar la rama; no se asume main.')
                    }
                    def mainBranch = env.SOURCE_BRANCH in ['main', 'origin/main', 'refs/heads/main', 'refs/remotes/origin/main']
                    env.SHOULD_DEPLOY = (params.DEPLOY != false && mainBranch && !env.CHANGE_ID && !env.TAG_NAME) ? 'true' : 'false'
                    env.IMAGE_TAG = "local-${env.BUILD_NUMBER}-${env.GIT_SHORT}"
                }
                sh '''
                    set -eu
                    mkdir -p reports/ci
                    rm -f reports/semgrep-report.txt
                    docker info >/dev/null
                    docker build -f jenkins/Dockerfile.jenkins -t playhub-jenkins:local jenkins
                '''
                echo "Rama: ${env.SOURCE_BRANCH} | Imagenes: ${env.IMAGE_TAG} | Deploy local: ${env.SHOULD_DEPLOY}"
            }
        }
        stage('2. Analisis estatico - Semgrep') {
            steps { sh 'bash scripts/ci/with-tools.sh bash scripts/ci/scan-semgrep.sh' }
        }
        stage('3. Construccion y tests') {
            failFast true
            parallel {
                stage('Backend') {
                    steps { sh 'bash scripts/ci/with-tools.sh bash scripts/ci/run-build.sh backend' }
                    post {
                        always {
                            junit testResults: 'backend/target/surefire-reports/*.xml', allowEmptyResults: false
                        }
                    }
                }
                stage('Frontend') {
                    steps { sh 'bash scripts/ci/with-tools.sh bash scripts/ci/run-build.sh frontend' }
                }
            }
        }
        stage('4. Construccion y publicacion Docker') {
            steps {
                sh 'bash scripts/ci/with-tools.sh bash scripts/ci/build-images.sh'
                sh 'bash scripts/ci/with-tools.sh bash scripts/ci/publish-local.sh'
            }
        }
        stage('5. Despliegue automatico con Helm') {
            when { expression { env.SHOULD_DEPLOY == 'true' } }
            steps {
                sh 'bash scripts/ci/with-tools.sh helm lint helm-chart -f helm-chart/values-dev.yaml -f helm-chart/values-lab.yaml -f helm-chart/values-local.yaml'
                sh 'bash scripts/ci/with-tools.sh bash scripts/ci/deploy-local.sh'
            }
        }
    }
    post {
        always {
            archiveArtifacts artifacts: 'reports/ci/**,reports/semgrep-report.txt', allowEmptyArchive: true
            deleteDir()
        }
        failure { echo 'Pipeline detenida: revisar la etapa fallida y sus reportes.' }
    }
}
