# Formato del Secret file "playhub-app-secrets" de Jenkins.
# Generar valores aleatorios, por ejemplo:
#   openssl rand -hex 24   (DB_PASSWORD)
#   openssl rand -hex 48   (JWT_SECRET, 48+ bytes)
#   openssl rand -hex 18   (ADMIN_PASSWORD)
DB_PASSWORD=REPLACE_WITH_RANDOM_DB_PASSWORD
JWT_SECRET=REPLACE_WITH_RANDOM_JWT_SECRET_DE_AL_MENOS_48_BYTES_UTF8
ADMIN_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_PASSWORD
